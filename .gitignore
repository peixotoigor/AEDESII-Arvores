# ----------------------------------------------------
# Regra padrao: ignora tudo na raiz do repositorio
# ----------------------------------------------------
/*

# ----------------------------------------------------
# Excecoes na raiz: apenas arquivos e pastas desejados
# ----------------------------------------------------
!.gitignore
!README*

# Pastas permitidas
!/codigo/
!/imagens/

# ----------------------------------------------------
# Arquivos compilados, temporarios e de cache
# ----------------------------------------------------
# Binarios C++
*.exe
*.o
*.obj
teste_*
run_benchmarks
benchmark_bin
codigo/**/teste_*
codigo/**/run_benchmarks
codigo/**/benchmark_bin

# Python cache
__pycache__/
*.pyc

# Arquivos auxiliares de LaTeX
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# Temporarios / scratch
scratch/
